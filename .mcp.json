{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "azure": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    },
    "workiq": {
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/workiq@latest",
        "mcp"
      ]
    }
  }
}
